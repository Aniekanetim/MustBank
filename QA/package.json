{
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aniekanetim/MustBank.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "name": "mustpayroll-qa",
  "description": "MustPayroll quality assurance, quality control and assessment handoff.",
  "scripts": {
    "build:pair": "node scripts/build-pair.mjs",
    "start:pair": "node scripts/start-build.mjs both",
    "start:buggy": "node scripts/start-build.mjs buggy",
    "start:fixed": "node scripts/start-build.mjs fixed",
    "test": "playwright test --config \"Quality Control/execute_test_cases/playwright.config.ts\"",
    "test:service": "node --test \"Quality Control/execute_test_cases/test/service.test.mjs\"",
    "scenario": "node scripts/scenario.mjs",
    "verify": "tsc --noEmit && node \"Quality Control/execute_test_cases/scripts/verify.mjs\"",
    "qc:design": "node \"Quality Control/execute_test_cases/scripts/test-suite.mjs\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3"
  }
}
